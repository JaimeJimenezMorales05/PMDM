<resources>
    <style name="Theme.LayoutsJaime" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/boton_op</item>
        <item name="colorPrimaryDark">@color/fondo_calc</item>
        <item name="colorAccent">@color/boton_op</item>
        <item name="android:windowBackground">@color/fondo_calc</item>
        <item name="android:statusBarColor">@color/fondo_calc</item>
        <item name="android:navigationBarColor">@color/fondo_calc</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="BotonCalc" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/boton_num</item>
        <item name="android:textColor">@color/texto_boton</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Botones de operaciones redondos -->
    <style name="BotonOp" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/boton_op</item>
        <item name="android:textColor">@color/texto_boton</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
